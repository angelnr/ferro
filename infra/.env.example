# Copia a infra/.env y cambia los valores. No commitees infra/.env.
POSTGRES_DB=ferro
POSTGRES_USER=ferro
POSTGRES_PASSWORD=cambia-esta-password

# Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Dominio público para Caddy (DNS apuntando a la VM). En local: localhost.
FERRO_DOMAIN=api.example.com

IMAGE_TAG=latest

# Frontend y CORS (en producción apuntan a Vercel)
APP_FRONTEND_URL=https://ferro.vercel.app
CORS_ALLOWED_ORIGINS=https://ferro.vercel.app

# SMTP (Mailpit en dev; proveedor real en producción)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@ferro.dev
